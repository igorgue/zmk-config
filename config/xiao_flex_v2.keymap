#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        gaming_mode {
            bindings = <&tog 2>;
            key-positions = <65 64>;
        };
    };

    behaviors {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_LEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <30 31 32 33 34 35>;
            quick-tap-ms = <150>;
        };

        ctrl_esc: ctrl_esc {
            compatible = "zmk,behavior-hold-tap";
            label = "CTRL_ESC";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            require-prior-idle-ms = <150>;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_RIGHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <24 25 26 27 28 29>;
            quick-tap-ms = <150>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        coding_default {
            bindings = <
&kp GRAVE                      &kp N1           &kp N2           &kp N3            &kp N4             &kp N5           &kp N6         &kp N7              &kp N8             &kp N9            &kp N0                    &kp EQUAL
&kp TAB                        &kp Q            &kp W            &kp E             &kp R              &kp T            &kp Y          &kp U               &kp I              &kp O             &kp P                     &kp MINUS
&ctrl_esc LEFT_CONTROL ESCAPE  &hml LEFT_GUI A  &hml LEFT_ALT S  &hml LCTRL D      &hml LEFT_SHIFT F  &kp G            &kp H          &hmr RIGHT_SHIFT J  &hmr RCTRL K       &hmr RIGHT_ALT L  &hmr RIGHT_GUI SEMICOLON  &kp SQT
&kp LSHFT                      &kp Z            &kp X            &kp C             &kp V              &kp B            &kp N          &kp M               &kp COMMA          &kp DOT           &kp FSLH                  &kp BSLH
&kp LEFT_ALT                   &kp ESC          &kp LEFT         &kp RIGHT                                                                                &kp DOWN           &kp UP            &kp LBKT                  &kp RBKT
                                                                 &kp SPACE         &kp BACKSPACE      &kp LEFT_META    &kp RIGHT_ALT  &kp DEL             &kp ENTER
                                                                 &sk LEFT_CONTROL  &sk LEFT_SHIFT     &sl 1            &sl 1          &sk RIGHT_SHIFT     &sk RIGHT_CONTROL
            >;
        };

        system_1 {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1   &bt BT_SEL 2          &bt BT_SEL 3  &bt BT_SEL 4    &kp K_LOCK  &kp C_SLEEP  &kp C_POWER        &trans       &kp C_MUTE       &kp C_VOLUME_UP
&trans      &trans        &trans         &trans                &trans        &trans          &trans      &trans       &trans             &trans       &kp PRINTSCREEN  &kp C_VOLUME_DOWN
&kp F1      &kp F2        &kp F3         &kp F4                &kp F5        &kp F6          &kp F7      &kp F8       &kp F9             &kp F10      &kp F11          &kp F12
&trans      &trans        &kp C_BRI_DEC  &kp C_BRIGHTNESS_INC  &trans        &trans          &trans      &kp HOME     &kp PAGE_DOWN      &kp PAGE_UP  &kp END          &trans
&trans      &kp CAPSLOCK  &trans         &trans                                                                       &trans             &trans       &trans           &trans
                                         &kp C_NEXT            &kp C_PP      &trans          &trans      &kp C_MUTE   &kp C_VOLUME_UP
                                         &kp C_PREV            &trans        &trans          &trans      &trans       &kp C_VOLUME_DOWN
            >;
        };

        gaming_2 {
            bindings = <
&trans  &trans            &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans         &trans
&kp T   &kp TAB           &kp Q   &kp W   &kp E   &kp R     &trans  &trans  &trans  &trans  &trans         &trans
&kp G   &kp LEFT_CONTROL  &kp A   &kp S   &kp D   &kp F     &trans  &kp J   &kp K   &kp L   &kp SEMICOLON  &trans
&kp B   &kp LSHFT         &kp Z   &kp X   &kp C   &kp V     &trans  &trans  &trans  &trans  &trans         &trans
&trans  &trans            &trans  &trans                                    &trans  &trans  &trans         &trans
                                  &trans  &kp H   &trans    &trans  &trans  &trans
                                  &kp Y   &kp N   &sl 3     &sl 1   &trans  &trans
            >;
        };

        system_3 {
            bindings = <
&kp F6   &kp F1   &kp F2   &kp F3      &kp F4    &kp F5    &trans  &trans      &trans             &trans       &trans           &trans
&kp F7   &trans   &trans   &trans      &trans    &trans    &trans  &trans      &trans             &trans       &kp PRINTSCREEN  &trans
&kp F8   &trans   &trans   &trans      &trans    &trans    &trans  &trans      &trans             &trans       &trans           &trans
&kp F9   &trans   &trans   &trans      &trans    &trans    &trans  &kp HOME    &kp PAGE_DOWN      &kp PAGE_UP  &kp END          &trans
&kp F10  &kp F11  &kp F12  &trans                                              &trans             &trans       &trans           &trans
                           &kp C_NEXT  &kp C_PP  &trans    &trans  &kp C_MUTE  &kp C_VOLUME_UP
                           &kp C_PREV  &trans    &trans    &trans  &trans      &kp C_VOLUME_DOWN
            >;
        };
    };
};
