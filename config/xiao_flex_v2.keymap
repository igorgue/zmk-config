#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        gaming_mode {
            bindings = <&tog 2>;
            key-positions = <65 64>;
        };

        homerow_mods_1 {
            bindings = <&tog 4>;
            key-positions = <64 28 31>;
        };

        homerow_mods_2 {
            bindings = <&tog 4>;
            key-positions = <28 31 65>;
        };
    };

    behaviors {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_LEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <110>;
            hold-trigger-key-positions = <31 32 33 34>;
            quick-tap-ms = <180>;
            hold-trigger-on-release;
        };

        ctrl_esc: ctrl_esc {
            compatible = "zmk,behavior-hold-tap";
            label = "CTRL_ESC";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "balanced";
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_RIGHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <110>;
            hold-trigger-key-positions = <24 25 26 27 28>;
            quick-tap-ms = <180>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        coding_default {
            bindings = <
&kp GRAVE                      &kp N1    &kp N2        &kp N3            &kp N4          &kp N5           &kp N6         &kp N7           &kp N8             &kp N9             &kp N0           &kp EQUAL
&kp TAB                        &kp Q     &kp W         &kp E             &kp R           &kp T            &kp Y          &kp U            &kp I              &kp O              &kp P            &kp MINUS
&ctrl_esc LEFT_CONTROL ESCAPE  &kp A     &kp S         &kp D             &kp F           &kp G            &kp H          &kp J            &kp K              &kp L              &kp SEMI         &kp SQT
&kp LSHFT                      &kp Z     &kp X         &kp C             &kp V           &kp B            &kp N          &kp M            &kp COMMA          &kp DOT            &kp FSLH         &kp BSLH
&kp LEFT                       &kp DOWN  &kp UP_ARROW  &kp RIGHT                                                                          &kp LEFT_BRACKET   &kp RIGHT_BRACKET  &kp RIGHT_SHIFT  &ctrl_esc RCTRL ESC
                                                       &kp SPACE         &kp BACKSPACE   &kp LEFT_META    &kp RIGHT_ALT  &kp DEL          &kp ENTER
                                                       &sk LEFT_CONTROL  &sk LEFT_SHIFT  &sl 1            &sl 1          &sk RIGHT_SHIFT  &sk RIGHT_CONTROL
            >;
        };

        system_1 {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1   &bt BT_SEL 2          &bt BT_SEL 3  &bt BT_SEL 4    &kp K_LOCK  &kp C_SLEEP  &kp C_POWER        &trans       &kp C_MUTE       &kp C_VOLUME_UP
&tog 5      &trans        &trans         &trans                &trans        &trans          &trans      &trans       &trans             &trans       &kp PRINTSCREEN  &kp C_VOLUME_DOWN
&kp F1      &kp F2        &kp F3         &kp F4                &kp F5        &kp F6          &kp F7      &kp F8       &kp F9             &kp F10      &kp F11          &kp F12
&kp CAPS    &trans        &kp C_BRI_DEC  &kp C_BRIGHTNESS_INC  &trans        &trans          &trans      &kp HOME     &kp PAGE_DOWN      &kp PAGE_UP  &kp END          &trans
&trans      &trans        &trans         &trans                                                                       &kp LEFT           &kp DOWN     &kp UP           &kp RIGHT
                                         &kp C_NEXT            &kp C_PP      &trans          &trans      &kp C_MUTE   &kp C_VOLUME_UP
                                         &kp C_PREV            &trans        &trans          &trans      &trans       &kp C_VOLUME_DOWN
            >;
        };

        gaming_2 {
            bindings = <
&trans  &trans            &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans         &trans
&kp T   &kp TAB           &kp Q   &kp W   &kp E   &kp R     &trans  &trans  &trans  &trans  &trans         &trans
&kp G   &kp LEFT_CONTROL  &kp A   &kp S   &kp D   &kp F     &trans  &kp J   &kp K   &kp L   &kp SEMICOLON  &trans
&kp B   &kp LSHFT         &kp Z   &kp X   &kp C   &kp V     &trans  &trans  &trans  &trans  &trans         &trans
&kp U   &kp ESC           &kp J   &kp M                                     &trans  &trans  &trans         &trans
                                  &trans  &kp H   &trans    &trans  &trans  &trans
                                  &kp Y   &kp N   &sl 3     &sl 1   &trans  &trans
            >;
        };

        system_3 {
            bindings = <
&kp F6   &kp F1   &kp F2   &kp F3      &kp F4    &kp F5    &trans  &trans      &trans             &trans       &trans           &trans
&kp F7   &trans   &trans   &trans      &trans    &trans    &trans  &trans      &trans             &trans       &kp PRINTSCREEN  &trans
&kp F8   &trans   &trans   &trans      &trans    &trans    &trans  &trans      &trans             &trans       &trans           &trans
&kp F9   &trans   &trans   &trans      &trans    &trans    &trans  &kp HOME    &kp PAGE_DOWN      &kp PAGE_UP  &kp END          &trans
&kp F10  &kp F11  &kp F12  &trans                                              &trans             &trans       &trans           &trans
                           &kp C_NEXT  &kp C_PP  &trans    &trans  &kp C_MUTE  &kp C_VOLUME_UP
                           &kp C_PREV  &trans    &trans    &trans  &trans      &kp C_VOLUME_DOWN
            >;
        };

        homerow_mods_training_4 {
            bindings = <
&trans   &trans           &trans           &trans        &trans             &trans    &trans  &trans              &trans        &trans            &trans                    &trans
&trans   &trans           &trans           &trans        &trans             &trans    &trans  &trans              &trans        &trans            &trans                    &trans
&kp ESC  &hml LEFT_WIN A  &hml LEFT_ALT S  &hml LCTRL D  &hml LEFT_SHIFT F  &trans    &trans  &hmr RIGHT_SHIFT J  &hmr RCTRL K  &hmr RIGHT_ALT L  &hmr RIGHT_WIN SEMICOLON  &trans
&none    &trans           &trans           &trans        &trans             &trans    &trans  &trans              &trans        &trans            &trans                    &trans
&trans   &trans           &trans           &trans                                                                 &trans        &trans            &none                     &none
                                           &trans        &trans             &none     &none   &trans              &trans
                                           &none         &none              &trans    &trans  &none               &none
            >;
        };

        homerow_mods {
            bindings = <
&trans  &trans           &trans           &trans        &trans             &trans    &trans  &trans              &trans        &trans            &trans                    &trans
&trans  &trans           &trans           &trans        &trans             &trans    &trans  &trans              &trans        &trans            &trans                    &trans
&trans  &hml LEFT_WIN A  &hml LEFT_ALT S  &hml LCTRL D  &hml LEFT_SHIFT F  &trans    &trans  &hmr RIGHT_SHIFT J  &hmr RCTRL K  &hmr RIGHT_ALT L  &hmr RIGHT_WIN SEMICOLON  &trans
&trans  &trans           &trans           &trans        &trans             &trans    &trans  &trans              &trans        &trans            &trans                    &trans
&trans  &trans           &trans           &trans                                                                 &trans        &trans            &trans                    &trans
                                          &trans        &trans             &trans    &trans  &trans              &trans
                                          &trans        &trans             &trans    &trans  &trans              &trans
            >;
        };
    };
};
